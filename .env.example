# environment variables
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

#postgres credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost


# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET="RANDOM_SECRET_FOR_ACCESS_TOKEN"
JWT_REFRESH_SECRET="RANDOM_SECRET_FOR_REFRESH_TOKEN - must be different from ACCESS_SECRET - make sure to use a strong random string - this is used to sign the refresh token"

# Token Lifetimes
JWT_ACCESS_EXPIRES_IN="15m" # 15 minutes - should be shorter than refresh token
JWT_REFRESH_EXPIRES_IN="7d" # 7 days - should be longer than access token

# CORS — comma-separated allowlist (required when credentials: true)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Public app URL (verification / password-reset links)
APP_PUBLIC_URL="http://localhost:5173"

# Max failed logins before account lock
MAX_FAILED_LOGINS=5

# Account lock duration (minutes)
ACCOUNT_LOCK_MINUTES=15